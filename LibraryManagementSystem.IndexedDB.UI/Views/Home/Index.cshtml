@{
    ViewData["Title"] = "Library Management System (IndexedDB UI)";
}

<!-- Header Bar -->
<div class="library-header">
    <div class="header-brand">
        <div class="header-title-group">
            <h1>📖 Library Management System</h1>
            <p>IndexedDB Browser Cache &amp; Web API SQL Server Synchronization</p>
        </div>
    </div>
</div>

<!-- App Layout Container (Sidebar + Main Content Area) -->
<div class="app-layout">

    <!-- Vertical Navigation Sidebar -->
    <aside class="library-sidebar">
        <div class="sidebar-header">
            <span class="sidebar-title">Navigation</span>
        </div>
        <ul class="library-nav-list">
            <li class="library-nav-item">
                <button class="library-tab-btn active" data-tab="books">
                    <span class="nav-icon">📚</span>
                    <span class="nav-label">Books</span>
                </button>
            </li>
            <li class="library-nav-item">
                <button class="library-tab-btn" data-tab="borrowers">
                    <span class="nav-icon">👥</span>
                    <span class="nav-label">Borrowers</span>
                </button>
            </li>
            <li class="library-nav-item">
                <button class="library-tab-btn" data-tab="borrowings">
                    <span class="nav-icon">📋</span>
                    <span class="nav-label">Borrowings</span>
                </button>
            </li>
            <li class="library-nav-item">
                <button class="library-tab-btn" data-tab="overdue">
                    <span class="nav-icon">⚠️</span>
                    <span class="nav-label">Overdue Books</span>
                </button>
            </li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <div class="main-container">

    <!-- ========================================================================= -->
    <!-- 1. BOOKS TAB PANE                                                        -->
    <!-- ========================================================================= -->
    <div id="pane-books" class="tab-pane">
        <div class="panel-card">
            <div class="panel-header-bar flex-wrap gap-2">
                <span class="panel-title">📚 Books Management</span>
                <button id="btnOpenAddBookModal" class="btn-modern-accent ms-auto">
                    + Add Book
                </button>
            </div>

            <!-- Fast IndexedDB Search Bar -->
            <div class="row align-items-center mb-3">
                <div class="col-md-8 col-lg-6">
                    <div class="search-box-container mb-0">
                        <input type="text" id="searchBookInput" class="form-control" placeholder="Search title, author, or genre..." />
                        <button id="btnSearchBooks" class="btn-modern-accent">🔍 Search</button>
                        <button id="btnViewAllBooks" class="btn-modern-outline">View All</button>
                    </div>
                </div>
            </div>

            <!-- Books DataGrid Table -->
            <div class="table-responsive">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Language</th>
                            <th>Total</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="booksTableBody">
                        <!-- Populated via JS from IndexedDB -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. BORROWERS TAB PANE                                                    -->
    <!-- ========================================================================= -->
    <div id="pane-borrowers" class="tab-pane" style="display: none;">
        <div class="panel-card">
            <div class="panel-header-bar flex-wrap gap-2">
                <span class="panel-title">👥 Borrowers Management</span>
                <button id="btnOpenAddBorrowerModal" class="btn-modern-accent ms-auto">
                    + Add Borrower
                </button>
            </div>

            <!-- Fast IndexedDB Borrower Search -->
            <div class="row align-items-center mb-3">
                <div class="col-md-8 col-lg-6">
                    <div class="search-box-container mb-0">
                        <input type="text" id="searchBorrowerInput" class="form-control" placeholder="Search name, phone, or email..." />
                        <button id="btnSearchBorrowers" class="btn-modern-accent">🔍 Search</button>
                        <button id="btnViewAllBorrowers" class="btn-modern-outline">View All</button>
                    </div>
                </div>
            </div>

            <!-- Borrowers DataGrid Table -->
            <div class="table-responsive">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="borrowersTableBody">
                        <!-- Populated via JS from IndexedDB -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. BORROWINGS TAB PANE                                                   -->
    <!-- ========================================================================= -->
    <div id="pane-borrowings" class="tab-pane" style="display: none;">
        <div class="panel-card">
            <div class="panel-header-bar flex-wrap gap-2">
                <span class="panel-title">📋 Borrowings Records</span>
                <button id="btnOpenLendModal" class="btn-modern-accent ms-auto">
                    + Lend Book
                </button>
            </div>

            <!-- Borrowings DataGrid Table -->
            <div class="table-responsive">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th>Borrower</th>
                            <th>Book Title</th>
                            <th>Borrow Date</th>
                            <th>Due Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="borrowingsTableBody">
                        <!-- Populated via JS from IndexedDB -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 4. OVERDUE BOOKS TAB PANE                                                -->
    <!-- ========================================================================= -->
    <div id="pane-overdue" class="tab-pane" style="display: none;">
        <div class="panel-card">
            <div class="panel-header-bar">
                <span class="panel-title">Overdue Books List (IndexedDB Analysis)</span>
                <button id="btnRefreshOverdue" class="btn-modern-outline">🔄 Refresh</button>
            </div>
            <div class="table-responsive">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th>Borrower</th>
                            <th>Book Title</th>
                            <th>Borrow Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="overdueTableBody">
                        <!-- Populated via JS from IndexedDB -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL BOXES                                                               -->
<!-- ========================================================================= -->

<!-- 1. Book Modal -->
<div id="bookModal" class="custom-modal-backdrop" style="display: none;">
    <div class="custom-modal">
        <div class="custom-modal-header">
            <h5 id="bookModalTitle" class="m-0 fw-bold">Add New Book</h5>
            <button id="btnCloseBookModal" class="btn-close btn-close-white" aria-label="Close"></button>
        </div>
        <div class="custom-modal-body">
            <div class="form-group mb-3">
                <label for="bookTitle" class="fw-semibold">Title *</label>
                <input type="text" id="bookTitle" class="form-control" placeholder="e.g. Clean Code" />
            </div>

            <div class="row mb-3">
                <div class="col-md-6 form-group">
                    <label for="bookAuthor" class="fw-semibold">Author *</label>
                    <input type="text" id="bookAuthor" class="form-control" placeholder="e.g. Robert C. Martin" />
                </div>
                <div class="col-md-6 form-group">
                    <label for="bookGenre" class="fw-semibold">Genre *</label>
                    <input type="text" id="bookGenre" class="form-control" placeholder="e.g. Programming" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="bookLanguage" class="fw-semibold">Language</label>
                <input type="text" id="bookLanguage" class="form-control" placeholder="e.g. English" value="English" />
            </div>

            <div class="form-group mb-3">
                <label for="bookDescription" class="fw-semibold">Description</label>
                <textarea id="bookDescription" class="form-control" rows="3" placeholder="Brief synopsis..."></textarea>
            </div>

            <div class="row mb-3">
                <div class="col-6 form-group">
                    <label for="bookTotalBooks" class="fw-semibold">Total Copies *</label>
                    <input type="number" id="bookTotalBooks" class="form-control" min="1" value="1" />
                </div>
                <div class="col-6 form-group">
                    <label for="bookAvailableBooks" class="fw-semibold">Available Copies</label>
                    <input type="number" id="bookAvailableBooks" class="form-control" readonly disabled value="1" />
                </div>
            </div>
        </div>
        <div class="custom-modal-footer gap-2">
            <button id="btnCreateBook" class="btn-modern-accent">+ Save Book</button>
            <button id="btnUpdateBook" class="btn-modern-primary" style="display: none;">✎ Update</button>
            <button id="btnDeleteBook" class="btn-modern-danger" style="display: none;">🗑 Delete</button>
            <button id="btnClearBookForm" class="btn-modern-outline">⌫ Clear</button>
            <button onclick="window.appController.closeBookModal()" class="btn-modern-outline">Close</button>
        </div>
    </div>
</div>

<!-- 2. Borrower Modal -->
<div id="borrowerModal" class="custom-modal-backdrop" style="display: none;">
    <div class="custom-modal">
        <div class="custom-modal-header">
            <h5 id="borrowerModalTitle" class="m-0 fw-bold">Add New Borrower</h5>
            <button id="btnCloseBorrowerModal" class="btn-close btn-close-white" aria-label="Close"></button>
        </div>
        <div class="custom-modal-body">
            <div class="form-group mb-3">
                <label for="borrowerName" class="fw-semibold">Borrower Name *</label>
                <input type="text" id="borrowerName" class="form-control" placeholder="e.g. John Doe" />
            </div>

            <div class="form-group mb-3">
                <label for="borrowerPhone" class="fw-semibold">Phone *</label>
                <input type="text" id="borrowerPhone" class="form-control" placeholder="e.g. 09123456789" />
            </div>

            <div class="form-group mb-3">
                <label for="borrowerEmail" class="fw-semibold">Email</label>
                <input type="email" id="borrowerEmail" class="form-control" placeholder="e.g. john@example.com" />
            </div>
        </div>
        <div class="custom-modal-footer gap-2">
            <button id="btnCreateBorrower" class="btn-modern-accent">+ Save Borrower</button>
            <button id="btnUpdateBorrower" class="btn-modern-primary" style="display: none;">✎ Update</button>
            <button id="btnDeleteBorrower" class="btn-modern-danger" style="display: none;">🗑 Delete</button>
            <button id="btnViewHistory" class="btn-modern-outline" style="display: none;">📖 History</button>
            <button id="btnClearBorrowerForm" class="btn-modern-outline">⌫ Clear</button>
            <button onclick="window.appController.closeBorrowerModal()" class="btn-modern-outline">Close</button>
        </div>
    </div>
</div>

<!-- 3. Lend Book Modal -->
<div id="lendBookModal" class="custom-modal-backdrop" style="display: none;">
    <div class="custom-modal">
        <div class="custom-modal-header">
            <h5 id="lendModalTitle" class="m-0 fw-bold">Lend Book (New Loan)</h5>
            <button id="btnCloseLendModal" class="btn-close btn-close-white" aria-label="Close"></button>
        </div>
        <div class="custom-modal-body">
            <div class="form-group mb-3">
                <label for="borrowingBorrowerSelect" class="fw-semibold">Borrower *</label>
                <select id="borrowingBorrowerSelect" class="form-select">
                    <option value="">-- Select Borrower --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="borrowingBookSelect" class="fw-semibold">Book (Available > 0) *</label>
                <select id="borrowingBookSelect" class="form-select">
                    <option value="">-- Select Book --</option>
                </select>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 form-group">
                    <label for="borrowingBorrowDate" class="fw-semibold">Borrow Date *</label>
                    <input type="date" id="borrowingBorrowDate" class="form-control" />
                </div>
                <div class="col-md-6 form-group">
                    <label for="borrowingDueDate" class="fw-semibold">Due Date *</label>
                    <input type="date" id="borrowingDueDate" class="form-control" />
                </div>
            </div>
        </div>
        <div class="custom-modal-footer gap-2">
            <button id="btnLendBook" class="btn-modern-accent">+ Issue Loan</button>
            <button id="btnClearBorrowingForm" class="btn-modern-outline">⌫ Clear</button>
            <button onclick="window.appController.closeLendModal()" class="btn-modern-outline">Close</button>
        </div>
    </div>
</div>

<!-- 4. Borrowing History Modal -->
<div id="customModal" class="custom-modal-backdrop" style="display: none;">
    <div class="custom-modal">
        <div class="custom-modal-header">
            <h5 id="modalTitle" class="m-0 fw-bold">Borrowing History</h5>
            <button id="btnCloseModal" class="btn-close btn-close-white" aria-label="Close"></button>
        </div>
        <div id="modalBody" class="custom-modal-body">
            <!-- Loaded via JS -->
        </div>
        <div class="custom-modal-footer">
            <button onclick="window.appController.closeModal()" class="btn-modern-outline">Close</button>
        </div>
    </div>
</div>
